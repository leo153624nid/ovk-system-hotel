# Скопируйте в .env и при необходимости измените значения: cp .env.example .env

# --- Postgres (один сервер, отдельная БД и роль на каждый сервис) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
AUTH_DB_PASSWORD=auth_pass
HOTEL_DB_PASSWORD=hotel_pass
AUDIT_DB_PASSWORD=audit_pass

# --- NATS ---
NATS_PORT=4222

# --- Безопасность ---
# Общий секрет подписи JWT (HS256). Для любого окружения кроме локального замените: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_ISSUER=ovk-auth
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# --- Общие ---
LOG_LEVEL=debug
GATEWAY_PORT=8080
FRONTEND_PORT=3000
