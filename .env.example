# Скопируйте в .env и при необходимости измените значения: cp .env.example .env

# --- Postgres (один сервер, отдельная БД и роль на каждый сервис) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
AUTH_DB_PASSWORD=auth_pass
HOTEL_DB_PASSWORD=hotel_pass
AUDIT_DB_PASSWORD=audit_pass

# --- NATS ---
NATS_PORT=4222

# --- Безопасность ---
# Общий секрет подписи JWT (HS256). Для любого окружения кроме локального замените: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_ISSUER=ovk-auth
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# --- Gateway ---
# Лимит запросов с одного IP: общий и отдельный (строже) для входа и регистрации.
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
AUTH_RATE_LIMIT_PER_MIN=10
AUTH_RATE_LIMIT_BURST=5
# Origins через запятую, которым разрешён кросс-доменный доступ (нужно только для dev-сервера фронтенда).
CORS_ALLOWED_ORIGINS=
# CIDR прокси, чьему заголовку X-Real-IP можно верить (для определения IP клиента). Пусто: не верить никому.
TRUSTED_PROXIES=

# --- Общие ---
LOG_LEVEL=debug
GATEWAY_PORT=8080
FRONTEND_PORT=3000
